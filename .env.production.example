# Copy to .env next to compose.yaml.
# Without the Discord settings, login is OFF and anyone who can reach the server
# has full access — only acceptable on a private network (LAN / Tailscale).

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a redirect registered in the Discord developer portal.
DISCORD_REDIRECT_URI=https://mymimo.example.com/api/auth/discord/callback
# Your Discord user ID (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID).
DISCORD_ALLOWED_USER_IDS=

# Backup: the database is ./data/mymimo.db (plus -wal/-shm while running).
# For a consistent copy while it's running:
#   docker compose exec mymimo node -e "new (require('node:sqlite').DatabaseSync)('/data/mymimo.db').exec(\"VACUUM INTO '/data/backup.db'\")"
# then copy ./data/backup.db somewhere safe. Or stop the container and copy ./data.
