{
  "name": "mymimo-api",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "author": "Matthew Merrill",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "SEED_DEMO=1 node --watch --env-file-if-exists=.env index.ts",
    "start": "node --env-file-if-exists=.env index.ts",
    "typecheck": "tsc --noEmit",
    "db:reset": "rm -f ../data/mymimo.db ../data/mymimo.db-wal ../data/mymimo.db-shm && echo 'Database deleted; the next dev start re-seeds demo data.'"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2"
  }
}
