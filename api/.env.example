# Copy to api/.env and fill in. With DISCORD_CLIENT_ID/SECRET unset, login is
# disabled and every request acts as the seeded demo user.

# Discord developer portal → your application → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must exactly match a redirect URL registered on the Discord app (OAuth2 → Redirects).
# In dev it goes through the Vite proxy so the session cookie lands on the app's origin.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Comma-separated Discord user IDs allowed to sign in (Discord: Settings → Advanced →
# Developer Mode, then right-click yourself → Copy User ID). Empty = anyone may sign in
# and gets their own empty home.
DISCORD_ALLOWED_USER_IDS=
